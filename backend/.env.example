# ============================================================
# .env — Environment Variables (NEVER commit this file to Git)
#
# Copy this file to .env and fill in your real values.
# I deliberately keep all secrets out of source code so that
# the same codebase can run in dev, staging, and production
# without any code changes — only env var changes.
# ============================================================

# ── Node Environment ─────────────────────────────────────────
# I set this to "production" on Render to activate production
# logging, disable stack traces in error responses, etc.
NODE_ENV=development

# ── Server Port ───────────────────────────────────────────────
# Render injects its own PORT at runtime. I fall back to 5000
# locally. Do NOT hard-code this in server.js.
PORT=5000

# ── MongoDB Atlas Connection String ───────────────────────────
# Replace <username>, <password>, and <cluster-url> with your
# Atlas credentials. I recommend creating a dedicated DB user
# with only readWrite permissions — not the root account.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolioDB?retryWrites=true&w=majority

# ── JWT Secret ────────────────────────────────────────────────
# I recommend generating this with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use a different secret in production than in development.
JWT_SECRET=your_super_secret_jwt_key_replace_this_immediately

# ── JWT Token Expiry ──────────────────────────────────────────
# "7d" means the token is valid for 7 days. Adjust as needed.
JWT_EXPIRES_IN=7d

# ── Frontend URL (used by CORS allowedOrigins in server.js) ──
# Set this to your Vercel deployment URL in the Render dashboard.
FRONTEND_URL=http://localhost:5500
